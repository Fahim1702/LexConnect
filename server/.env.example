NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lexconnect
# Atlas DNS workaround. Use system to keep your operating system's DNS settings.
DNS_SERVERS=1.1.1.1,1.0.0.1
CLIENT_URL=http://localhost:5173
# Same project as the frontend Firebase web app.
FIREBASE_PROJECT_ID=
# Absolute path to a Firebase Admin service-account JSON file OUTSIDE the repo.
# Example: C:/Users/your-name/.config/lexconnect/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=
