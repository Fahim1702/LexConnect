NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lexconnect
# Atlas DNS workaround. Use system to keep your operating system's DNS settings.
DNS_SERVERS=1.1.1.1,1.0.0.1
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=LexConnect Admin
ADMIN_EMAIL=admin@lexconnect.test
ADMIN_PASSWORD=Admin123!
